---
import Footer from "@/components/Footer.astro";
import Layout from "@/layouts/Layout.astro";
import Timetable from "@/components/Timetable.tsx";
import { type Event } from "@/types/event.ts";

const timetable: Event[] = [
  {
    timestamp: new Date("21 Apr 2026 10:00:00 PM GMT+9").getTime(),
    label: "Album Trailer"
  },
  {
    timestamp: new Date("22 Apr 2026 10:00:00 PM GMT+9").getTime(),
    label: "Track List"
  },
  {
    timestamp: new Date("22 Apr 2026 10:00:00 PM GMT+9").getTime(),
    label: "Motion Poster"
  },
  {
    timestamp: new Date("24 Apr 2026 12:00:00 AM GMT+9").getTime(),
    label: "Concept Photo: Heavy Version"
  },
  {
    timestamp: new Date("25 Apr 2026 12:00:00 AM GMT+9").getTime(),
    label: "Concept Photo: Serenade Version"
  },
  {
    timestamp: new Date("26 Apr 2026 12:00:00 AM GMT+9").getTime(),
    label: "Special Website Launch"
  },
  {
    timestamp: new Date("27 Apr 2026 12:00:00 AM GMT+9").getTime(),
    label: 'Pre-release "Crescendo" M/V Teaser'
  },
  {
    timestamp: new Date("28 Apr 2026 06:00:00 PM GMT+9").getTime(),
    label: 'Pre-release "Crescendo" M/V'
  },
  {
    timestamp: new Date("5 May 2026 08:00:00 PM GMT+9").getTime(),
    label: "A Capella Highlight Medley"
  },
  {
    timestamp: new Date("7 May 2026 08:00:00 PM GMT+9").getTime(),
    label: "Original Highlight Medley"
  },
  {
    timestamp: new Date("8 May 2026 12:00:00 PM GMT+9").getTime(),
    label: '"Heavy Serenade" 3D Album Preview'
  },
  {
    timestamp: new Date("10 May 2026 12:00:00 AM GMT+9").getTime(),
    label: '"Heavy Serenade" M/V Teaser'
  },
  {
    timestamp: new Date("11 May 2026 04:40:00 PM GMT+9").getTime(),
    label: '"Heavy Serenade" Countdown Live'
  },
  {
    timestamp: new Date("11 May 2026 06:00:00 PM GMT+9").getTime(),
