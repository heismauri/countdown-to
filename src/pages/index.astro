].sort((a, b) => a.timestamp - b.timestamp);
---

<Layout>
  <noscript>
    <div class="m-5">JavaScript is disabled in your browser. Please enable it to view this page.</div>
  </noscript>
  <main class="container mx-auto min-h-svh flex flex-col justify-center items-center px-12 py-20">
    <div class="w-full h-dvh fixed top-0 left-0 -z-10">
      <iframe
        src="https://www.youtube.com/embed/gRZlaEbhbqs?autoplay=1&mute=1&loop=1&controls=0&rel=0&playsinline=1"
        allow="autoplay"
        class:list={[
          "w-lvw h-[56.25vw] min-h-[140vh] min-w-[177.77vh] absolute top-1/2 left-1/2 -translate-x-1/2",
          "-translate-y-1/2 pointer-events-none"
        ]}
        title="background-video"
        ></iframe>
    </div>
    <Timetable client:load events={timetable} />
    <Footer />
  </main>
</Layout>
