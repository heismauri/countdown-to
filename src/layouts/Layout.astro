---
import BaseHead from "@/components/BaseHead.astro";

import background from "@/assets/background.jpg";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead />
  </head>
  <body class="bg-[#476662] text-stone-50 relative">
    <div class="fixed inset-0 -z-10 bg-center bg-cover" style={`background-image: url(${background.src});`}></div>
    <slot />
  </body>
</html>
